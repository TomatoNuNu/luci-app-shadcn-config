# ── 本地数据，不随仓库分发 ──────────────────────────────────────────
# WorkBuddy 工程数据
.workbuddy/
# 本地的上游参考克隆（argon / shadcn 源码）与打补丁工作树
ref/
# 本地便携工具（GitHub CLI 等）
.tools/

# ── 构建产物 ────────────────────────────────────────────────────────
# ipk 走 GitHub Releases 分发，不进 git 历史（每次构建二进制都不同，会污染 diff）
dist/
# verify 套件首次运行时从 openwrt/luci 下载的缓存（不固化上游文件版本）
tools/verify/.cache/

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── macOS ──────────────────────────────────────────────────────────
.DS_Store
._*

# ── 编辑器 ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
